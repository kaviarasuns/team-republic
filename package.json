{
  "name": "team-republic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d --wait && pnpm db:migrate && vp run --parallel -F @team-republic/api -F @team-republic/web dev",
    "dev:mobile": "vp run -F @team-republic/mobile dev",
    "db:migrate": "pnpm --filter @team-republic/api db:migrate",
    "db:seed": "pnpm --filter @team-republic/api ingest:tn2021",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate && pnpm db:seed",
    "build": "vp run -r build",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp run -r test",
    "typecheck": "vp run -r typecheck"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "portless": "0.16.0",
    "typescript": "6.0.3",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@10.34.7"
}
