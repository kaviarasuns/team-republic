# Copy to .env for local development. Values match docker-compose.yml.
DATABASE_URL=postgres://team_republic:team_republic@localhost:5432/team_republic

# Object storage for archived source files. Locally SeaweedFS; in production AWS S3
# (leave S3_ENDPOINT empty and set S3_FORCE_PATH_STYLE=false).
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=team-republic-sources
S3_ACCESS_KEY_ID=local-dev-access-key
S3_SECRET_ACCESS_KEY=local-dev-secret-key
S3_FORCE_PATH_STYLE=true

API_PORT=4000
BETTER_AUTH_SECRET=change-me-local-only-32-characters-min
BETTER_AUTH_URL=http://localhost:4000

# Leave empty to disable tracing. Example: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=team-republic-api
