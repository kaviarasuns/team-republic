{
  "name": "@team-republic/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "ingest:tn2021": "node --env-file-if-exists=../../.env src/ingest/tn-2021.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@effect/platform-node": "4.0.5",
    "@effect/sql-pg": "4.0.5",
    "@team-republic/contracts": "workspace:*",
    "better-auth": "1.7.12",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.0.5",
    "exceljs": "4.4.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "6.0.3",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  }
}
